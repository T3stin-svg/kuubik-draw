(setvar "CLAYER" "F027_EDGE_CIRCLE")
(command "_.CIRCLE" '(900 0 0) 100)
(setq f027:edgeCircle (entlast))
(command "_.STRETCH" "_Crossing" '(990 -10 0) '(1010 10 0) "" '(0 0 0) '(25 5 0))
(f027:print-code "EDGE_CIRCLE_CENTER" f027:edgeCircle 10)

(setvar "CLAYER" "F027_INDIVIDUAL")
(setq f027:individual (entmakex '((0 . "LINE") (100 . "AcDbEntity") (8 . "F027_INDIVIDUAL") (100 . "AcDbLine") (10 0.0 500.0 0.0) (11 100.0 500.0 0.0) (210 0.0 0.0 1.0))))
(setq f027:set (ssadd f027:individual))
(command "_.STRETCH" f027:set "" '(0 0 0) '(25 5 0))
(f027:print-code "INDIVIDUAL_START" f027:individual 10)
(f027:print-code "INDIVIDUAL_END" f027:individual 11)
(f027:print-value "ACADVER" (getvar "ACADVER"))
(f027:print-value "DONE" 1)
(princ)
