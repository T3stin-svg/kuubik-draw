(setvar "CMDECHO" 1)
(vl-load-com)
(defun f012:point (point) (strcat (rtos (car point) 2 6) "," (rtos (cadr point) 2 6)))
(defun f012:point-list (points) (apply 'strcat (mapcar '(lambda (point) (strcat (f012:point point) ";")) points)))
(defun f012:number-list (values) (apply 'strcat (mapcar '(lambda (value) (strcat (rtos value 2 9) ";")) values)))
(command "_.SPLINE" (list 0.0 0.0 0.0) (list 40.0 70.0 0.0) (list 100.0 0.0 0.0) "" "" "")
(setq f012:entity (entlast))
(setq f012:original-start (vlax-curve-getStartPoint f012:entity))
(setq f012:original-end (vlax-curve-getEndPoint f012:entity))
(princ (strcat "\nF012_ACADVER=" (getvar "ACADVER")))
(princ (strcat "\nF012_CREATED_TYPE=" (cdr (assoc 0 (entget f012:entity)))))
(princ (strcat "\nF012_CREATED_FLAGS=" (itoa (cdr (assoc 70 (entget f012:entity))))))
(princ (strcat "\nF012_ORIGINAL_START=" (f012:point f012:original-start)))
(princ (strcat "\nF012_ORIGINAL_END=" (f012:point f012:original-end)))
(command "_.SPLINEDIT" f012:entity "_Reverse" "")
(princ (strcat "\nF012_REVERSED_START=" (f012:point (vlax-curve-getStartPoint f012:entity))))
(princ (strcat "\nF012_REVERSED_END=" (f012:point (vlax-curve-getEndPoint f012:entity))))
(command "_.SPLINEDIT" f012:entity "_Close" "")
(princ (strcat "\nF012_CLOSED_FLAGS=" (itoa (cdr (assoc 70 (entget f012:entity))))))
(princ (strcat "\nF012_CLOSED_SEAM_DISTANCE=" (rtos (distance (vlax-curve-getStartPoint f012:entity) (vlax-curve-getEndPoint f012:entity)) 2 9)))
(command "_.SPLINEDIT" f012:entity "_Open" "")
(princ (strcat "\nF012_OPENED_FLAGS=" (itoa (cdr (assoc 70 (entget f012:entity))))))
(setq f012:undo-start (vlax-curve-getStartPoint f012:entity))
(command "_.SPLINEDIT" f012:entity "_Reverse" "_Undo" "")
(princ (strcat "\nF012_COMMAND_UNDO_START=" (f012:point (vlax-curve-getStartPoint f012:entity))))
(princ (strcat "\nF012_COMMAND_UNDO_EXPECTED=" (f012:point f012:undo-start)))
(command "_.SPLINE" (list 0.0 400.0 0.0) (list 20.0 470.0 0.0) (list 60.0 390.0 0.0) (list 100.0 460.0 0.0) (list 140.0 400.0 0.0) "" "" "")
(setq f012:zero-tolerance-entity (entlast))
(princ (strcat "\nF012_ZERO_TOLERANCE_CONTROL_POINTS=" (f012:point-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 10)) (entget f012:zero-tolerance-entity))))))
(princ (strcat "\nF012_ZERO_TOLERANCE_KNOTS=" (f012:number-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 40)) (entget f012:zero-tolerance-entity))))))
(command "_.SPLINE" (list 0.0 200.0 0.0) (list 20.0 270.0 0.0) (list 60.0 190.0 0.0) (list 100.0 260.0 0.0) (list 140.0 200.0 0.0) "_Tolerance" 10.0 "" "" "")
(setq f012:tolerance-entity (entlast))
(setq f012:tolerance-input (list (list 0.0 200.0 0.0) (list 20.0 270.0 0.0) (list 60.0 190.0 0.0) (list 100.0 260.0 0.0) (list 140.0 200.0 0.0)))
(princ (strcat "\nF012_TOLERANCE_VALUE=" (rtos (cdr (assoc 44 (entget f012:tolerance-entity))) 2 6)))
(princ (strcat "\nF012_TOLERANCE_FIT_COUNT=" (itoa (length (vl-remove-if-not '(lambda (item) (= (car item) 11)) (entget f012:tolerance-entity))))))
(princ (strcat "\nF012_TOLERANCE_CONTROL_COUNT=" (itoa (length (vl-remove-if-not '(lambda (item) (= (car item) 10)) (entget f012:tolerance-entity))))))
(princ (strcat "\nF012_TOLERANCE_CONTROL_POINTS=" (f012:point-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 10)) (entget f012:tolerance-entity))))))
(princ (strcat "\nF012_TOLERANCE_KNOTS=" (f012:number-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 40)) (entget f012:tolerance-entity))))))
(setq f012:tolerance-closest (mapcar '(lambda (point) (vlax-curve-getClosestPointTo f012:tolerance-entity point)) f012:tolerance-input))
(princ (strcat "\nF012_TOLERANCE_CLOSEST_POINTS=" (f012:point-list f012:tolerance-closest)))
(princ (strcat "\nF012_TOLERANCE_DEVIATIONS=" (f012:number-list (mapcar '(lambda (point) (distance point (vlax-curve-getClosestPointTo f012:tolerance-entity point))) f012:tolerance-input))))
(command "_.SPLINE" (list 0.0 -200.0 0.0) (list 20.0 -270.0 0.0) (list 60.0 -190.0 0.0) (list 100.0 -260.0 0.0) (list 140.0 -200.0 0.0) "_Tolerance" 10.0 "" "" "")
(setq f012:tolerance-mirror-entity (entlast))
(setq f012:tolerance-mirror-input (list (list 0.0 -200.0 0.0) (list 20.0 -270.0 0.0) (list 60.0 -190.0 0.0) (list 100.0 -260.0 0.0) (list 140.0 -200.0 0.0)))
(setq f012:tolerance-mirror-closest (mapcar '(lambda (point) (vlax-curve-getClosestPointTo f012:tolerance-mirror-entity point)) f012:tolerance-mirror-input))
(princ (strcat "\nF012_TOLERANCE_MIRROR_CONTROL_POINTS=" (f012:point-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 10)) (entget f012:tolerance-mirror-entity))))))
(princ (strcat "\nF012_TOLERANCE_MIRROR_KNOTS=" (f012:number-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 40)) (entget f012:tolerance-mirror-entity))))))
(princ (strcat "\nF012_TOLERANCE_MIRROR_CLOSEST_POINTS=" (f012:point-list f012:tolerance-mirror-closest)))
(princ (strcat "\nF012_TOLERANCE_MIRROR_DEVIATIONS=" (f012:number-list (mapcar '(lambda (point) (distance point (vlax-curve-getClosestPointTo f012:tolerance-mirror-entity point))) f012:tolerance-mirror-input))))
(command "_.SPLINE" (list 0.0 -500.0 0.0) (list 40.0 -430.0 0.0) (list 100.0 -500.0 0.0) "" (list 180.0 -500.0 0.0) (list 220.0 -580.0 0.0))
(setq f012:pointer-tangent-entity (entlast))
(princ (strcat "\nF012_POINTER_TANGENT_START=" (f012:point (cdr (assoc 12 (entget f012:pointer-tangent-entity))))))
(princ (strcat "\nF012_POINTER_TANGENT_END=" (f012:point (cdr (assoc 13 (entget f012:pointer-tangent-entity))))))
(princ (strcat "\nF012_POINTER_TANGENT_CONTROL_POINTS=" (f012:point-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 10)) (entget f012:pointer-tangent-entity))))))
(princ (strcat "\nF012_POINTER_TANGENT_KNOTS=" (f012:number-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 40)) (entget f012:pointer-tangent-entity))))))
(princ (strcat "\nF012_POINTER_TANGENT_START_POINT=" (f012:point (vlax-curve-getStartPoint f012:pointer-tangent-entity))))
(princ (strcat "\nF012_POINTER_TANGENT_END_POINT=" (f012:point (vlax-curve-getEndPoint f012:pointer-tangent-entity))))
(command "_.SPLINE" (list 0.0 -700.0 0.0) (list 30.0 -630.0 0.0) (list 70.0 -760.0 0.0) (list 110.0 -640.0 0.0) (list 150.0 -700.0 0.0) "" "" "")
(setq f012:kink-entity (entlast))
(setq f012:kink-handle-before (cdr (assoc 5 (entget f012:kink-entity))))
(setq f012:kink-start-parameter (vlax-curve-getStartParam f012:kink-entity))
(setq f012:kink-end-parameter (vlax-curve-getEndParam f012:kink-entity))
(setq f012:kink-target-parameter (+ f012:kink-start-parameter (* 0.45 (- f012:kink-end-parameter f012:kink-start-parameter))))
(setq f012:kink-target-point (vlax-curve-getPointAtParam f012:kink-entity f012:kink-target-parameter))
(setq f012:kink-fit-count-before (length (vl-remove-if-not '(lambda (item) (= (car item) 11)) (entget f012:kink-entity))))
(setq f012:kink-fractions (list 0.0 0.05 0.1 0.15 0.2 0.25 0.3 0.35 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1.0))
(setq f012:kink-source-samples (mapcar '(lambda (fraction) (vlax-curve-getPointAtParam f012:kink-entity (+ f012:kink-start-parameter (* fraction (- f012:kink-end-parameter f012:kink-start-parameter))))) f012:kink-fractions))
(command "_.SPLINEDIT" f012:kink-entity "_Fit" "_Kink" f012:kink-target-point "" "_Exit" "")
(setq f012:kink-data (entget f012:kink-entity))
(setq f012:kink-after-samples (mapcar '(lambda (fraction) (vlax-curve-getPointAtParam f012:kink-entity (+ f012:kink-start-parameter (* fraction (- f012:kink-end-parameter f012:kink-start-parameter))))) f012:kink-fractions))
(setq f012:kink-sample-deviations (mapcar 'distance f012:kink-source-samples f012:kink-after-samples))
(setq f012:kink-point-after (vlax-curve-getClosestPointTo f012:kink-entity f012:kink-target-point))
(setq f012:kink-parameter-after (vlax-curve-getParamAtPoint f012:kink-entity f012:kink-point-after))
(setq f012:kink-epsilon (* 0.000001 (- (vlax-curve-getEndParam f012:kink-entity) (vlax-curve-getStartParam f012:kink-entity))))
(setq f012:kink-left-derivative (vlax-curve-getFirstDeriv f012:kink-entity (- f012:kink-parameter-after f012:kink-epsilon)))
(setq f012:kink-right-derivative (vlax-curve-getFirstDeriv f012:kink-entity (+ f012:kink-parameter-after f012:kink-epsilon)))
(princ (strcat "\nF012_KINK_HANDLE_BEFORE=" f012:kink-handle-before))
(princ (strcat "\nF012_KINK_HANDLE_AFTER=" (cdr (assoc 5 f012:kink-data))))
(princ (strcat "\nF012_KINK_TARGET_POINT=" (f012:point f012:kink-target-point)))
(princ (strcat "\nF012_KINK_POINT_AFTER=" (f012:point f012:kink-point-after)))
(princ (strcat "\nF012_KINK_FIT_COUNT_BEFORE=" (itoa f012:kink-fit-count-before)))
(princ (strcat "\nF012_KINK_FIT_COUNT_AFTER=" (itoa (length (vl-remove-if-not '(lambda (item) (= (car item) 11)) f012:kink-data)))))
(princ (strcat "\nF012_KINK_FLAGS_AFTER=" (itoa (cdr (assoc 70 f012:kink-data)))))
(princ (strcat "\nF012_KINK_DEGREE_AFTER=" (itoa (cdr (assoc 71 f012:kink-data)))))
(princ (strcat "\nF012_KINK_TARGET_PARAMETER=" (rtos f012:kink-target-parameter 2 9)))
(princ (strcat "\nF012_KINK_CONTROL_POINTS=" (f012:point-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 10)) f012:kink-data)))))
(princ (strcat "\nF012_KINK_FIT_POINTS=" (f012:point-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 11)) f012:kink-data)))))
(princ (strcat "\nF012_KINK_KNOTS=" (f012:number-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 40)) f012:kink-data)))))
(princ (strcat "\nF012_KINK_LEFT_DERIVATIVE=" (f012:point f012:kink-left-derivative)))
(princ (strcat "\nF012_KINK_RIGHT_DERIVATIVE=" (f012:point f012:kink-right-derivative)))
(princ (strcat "\nF012_KINK_SAMPLE_DEVIATIONS=" (f012:number-list f012:kink-sample-deviations)))
(princ (strcat "\nF012_KINK_MAX_DEVIATION=" (rtos (apply 'max f012:kink-sample-deviations) 2 12)))
(command "_.PLINE" (list 0.0 -900.0 0.0) (list 30.0 -830.0 0.0) (list 80.0 -920.0 0.0) (list 120.0 -900.0 0.0) "")
(setq f012:cv-source-polyline (entlast))
(command "_.PEDIT" f012:cv-source-polyline "_Spline" "")
(command "_.SPLINE" "_Object" f012:cv-source-polyline "")
(setq f012:cv-refine-entity (entlast))
(setq f012:cv-refine-handle (cdr (assoc 5 (entget f012:cv-refine-entity))))
(setq f012:cv-start-parameter (vlax-curve-getStartParam f012:cv-refine-entity))
(setq f012:cv-end-parameter (vlax-curve-getEndParam f012:cv-refine-entity))
(setq f012:cv-target-parameter (+ f012:cv-start-parameter (* 0.5 (- f012:cv-end-parameter f012:cv-start-parameter))))
(setq f012:cv-target-point (vlax-curve-getPointAtParam f012:cv-refine-entity f012:cv-target-parameter))
(setq f012:cv-fractions (list 0.0 0.05 0.1 0.15 0.2 0.25 0.3 0.35 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1.0))
(setq f012:cv-source-samples (mapcar '(lambda (fraction) (vlax-curve-getPointAtParam f012:cv-refine-entity (+ f012:cv-start-parameter (* fraction (- f012:cv-end-parameter f012:cv-start-parameter))))) f012:cv-fractions))
(setq f012:cv-source-data (entget f012:cv-refine-entity))
(princ (strcat "\nF012_CV_HANDLE_BEFORE=" f012:cv-refine-handle))
(princ (strcat "\nF012_CV_SOURCE_DEGREE=" (itoa (cdr (assoc 71 f012:cv-source-data)))))
(princ (strcat "\nF012_CV_SOURCE_CONTROL_COUNT=" (itoa (length (vl-remove-if-not '(lambda (item) (= (car item) 10)) f012:cv-source-data)))))
(princ (strcat "\nF012_CV_SOURCE_KNOT_COUNT=" (itoa (length (vl-remove-if-not '(lambda (item) (= (car item) 40)) f012:cv-source-data)))))
(princ (strcat "\nF012_CV_SOURCE_CONTROL_POINTS=" (f012:point-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 10)) f012:cv-source-data)))))
(princ (strcat "\nF012_CV_SOURCE_KNOTS=" (f012:number-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 40)) f012:cv-source-data)))))
(command "_.SPLINEDIT" f012:cv-refine-entity "_Refine" "_Add" f012:cv-target-point "" "_Exit" "")
(setq f012:cv-add-data (entget f012:cv-refine-entity))
(setq f012:cv-add-samples (mapcar '(lambda (fraction) (vlax-curve-getPointAtParam f012:cv-refine-entity (+ f012:cv-start-parameter (* fraction (- f012:cv-end-parameter f012:cv-start-parameter))))) f012:cv-fractions))
(setq f012:cv-add-deviations (mapcar 'distance f012:cv-source-samples f012:cv-add-samples))
(princ (strcat "\nF012_CV_HANDLE_AFTER_ADD=" (cdr (assoc 5 f012:cv-add-data))))
(princ (strcat "\nF012_CV_ADD_TARGET_PARAMETER=" (rtos f012:cv-target-parameter 2 9)))
(princ (strcat "\nF012_CV_ADD_TARGET_POINT=" (f012:point f012:cv-target-point)))
(princ (strcat "\nF012_CV_ADD_POINT_AFTER=" (f012:point (vlax-curve-getClosestPointTo f012:cv-refine-entity f012:cv-target-point))))
(princ (strcat "\nF012_CV_ADD_DEGREE=" (itoa (cdr (assoc 71 f012:cv-add-data)))))
(princ (strcat "\nF012_CV_ADD_CONTROL_COUNT=" (itoa (length (vl-remove-if-not '(lambda (item) (= (car item) 10)) f012:cv-add-data)))))
(princ (strcat "\nF012_CV_ADD_KNOT_COUNT=" (itoa (length (vl-remove-if-not '(lambda (item) (= (car item) 40)) f012:cv-add-data)))))
(princ (strcat "\nF012_CV_ADD_CONTROL_POINTS=" (f012:point-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 10)) f012:cv-add-data)))))
(princ (strcat "\nF012_CV_ADD_KNOTS=" (f012:number-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 40)) f012:cv-add-data)))))
(princ (strcat "\nF012_CV_ADD_SAMPLE_DEVIATIONS=" (f012:number-list f012:cv-add-deviations)))
(princ (strcat "\nF012_CV_ADD_MAX_DEVIATION=" (rtos (apply 'max f012:cv-add-deviations) 2 12)))
(command "_.SPLINEDIT" f012:cv-refine-entity "_Refine" "_Elevate" 5 "_Exit" "")
(setq f012:cv-elevate-data (entget f012:cv-refine-entity))
(setq f012:cv-elevate-samples (mapcar '(lambda (fraction) (vlax-curve-getPointAtParam f012:cv-refine-entity (+ f012:cv-start-parameter (* fraction (- f012:cv-end-parameter f012:cv-start-parameter))))) f012:cv-fractions))
(setq f012:cv-elevate-deviations (mapcar 'distance f012:cv-source-samples f012:cv-elevate-samples))
(princ (strcat "\nF012_CV_HANDLE_AFTER_ELEVATE=" (cdr (assoc 5 f012:cv-elevate-data))))
(princ "\nF012_CV_ELEVATE_ORDER=5")
(princ (strcat "\nF012_CV_ELEVATE_DEGREE=" (itoa (cdr (assoc 71 f012:cv-elevate-data)))))
(princ (strcat "\nF012_CV_ELEVATE_CONTROL_COUNT=" (itoa (length (vl-remove-if-not '(lambda (item) (= (car item) 10)) f012:cv-elevate-data)))))
(princ (strcat "\nF012_CV_ELEVATE_KNOT_COUNT=" (itoa (length (vl-remove-if-not '(lambda (item) (= (car item) 40)) f012:cv-elevate-data)))))
(princ (strcat "\nF012_CV_ELEVATE_CONTROL_POINTS=" (f012:point-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 10)) f012:cv-elevate-data)))))
(princ (strcat "\nF012_CV_ELEVATE_KNOTS=" (f012:number-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 40)) f012:cv-elevate-data)))))
(princ (strcat "\nF012_CV_ELEVATE_SAMPLE_DEVIATIONS=" (f012:number-list f012:cv-elevate-deviations)))
(princ (strcat "\nF012_CV_ELEVATE_MAX_DEVIATION=" (rtos (apply 'max f012:cv-elevate-deviations) 2 12)))
(command "_.PLINE" (list 200.0 0.0 0.0) (list 230.0 50.0 0.0) (list 270.0 -20.0 0.0) (list 320.0 0.0 0.0) "")
(setq f012:object-source (entlast))
(command "_.PEDIT" f012:object-source "_Spline" "")
(princ (strcat "\nF012_OBJECT_SOURCE_TYPE=" (cdr (assoc 0 (entget f012:object-source)))))
(princ (strcat "\nF012_OBJECT_SOURCE_HANDLE=" (cdr (assoc 5 (entget f012:object-source)))))
(command "_.SPLINE" "_Object" f012:object-source "")
(setq f012:object-result (entlast))
(princ (strcat "\nF012_OBJECT_SOURCE_AFTER=" (if (entget f012:object-source) (cdr (assoc 0 (entget f012:object-source))) "ERASED")))
(princ (strcat "\nF012_OBJECT_RESULT_TYPE=" (cdr (assoc 0 (entget f012:object-result)))))
(princ (strcat "\nF012_OBJECT_RESULT_HANDLE=" (cdr (assoc 5 (entget f012:object-result)))))
(princ (strcat "\nF012_OBJECT_RESULT_FLAGS=" (itoa (cdr (assoc 70 (entget f012:object-result))))))
(princ (strcat "\nF012_OBJECT_RESULT_CONTROL_COUNT=" (itoa (length (vl-remove-if-not '(lambda (item) (= (car item) 10)) (entget f012:object-result))))))
(princ (strcat "\nF012_OBJECT_RESULT_FIT_COUNT=" (itoa (length (vl-remove-if-not '(lambda (item) (= (car item) 11)) (entget f012:object-result))))))
(princ (strcat "\nF012_OBJECT_RESULT_CONTROL_POINTS=" (f012:point-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 10)) (entget f012:object-result))))))
(princ (strcat "\nF012_OBJECT_RESULT_KNOTS=" (f012:number-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 40)) (entget f012:object-result))))))
(setq f012:old-plineconvertmode (getvar "PLINECONVERTMODE"))
(setq f012:old-delobj (getvar "DELOBJ"))
(setvar "PLINECONVERTMODE" 0)
(setvar "DELOBJ" 1)
(command "_.SPLINE" (list 200.0 -300.0 0.0) (list 240.0 -220.0 0.0) (list 310.0 -330.0 0.0) (list 380.0 -250.0 0.0) "" "" "")
(setq f012:polyline-source (entlast))
(setq f012:polyline-source-handle (cdr (assoc 5 (entget f012:polyline-source))))
(setq f012:polyline-source-length (vlax-curve-getDistAtParam f012:polyline-source (vlax-curve-getEndParam f012:polyline-source)))
(setq f012:polyline-fractions (list 0.0 0.05 0.1 0.15 0.2 0.25 0.3 0.35 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1.0))
(setq f012:polyline-source-samples (mapcar '(lambda (fraction) (vlax-curve-getPointAtDist f012:polyline-source (* f012:polyline-source-length fraction))) f012:polyline-fractions))
(command "_.SPLINEDIT" f012:polyline-source "_P" 10)
(setq f012:polyline-result (entlast))
(setq f012:polyline-deviations (mapcar '(lambda (point) (distance point (vlax-curve-getClosestPointTo f012:polyline-result point))) f012:polyline-source-samples))
(princ (strcat "\nF012_POLYLINE_SOURCE_HANDLE=" f012:polyline-source-handle))
(princ (strcat "\nF012_POLYLINE_SOURCE_AFTER=" (if (entget f012:polyline-source) (cdr (assoc 0 (entget f012:polyline-source))) "ERASED")))
(princ (strcat "\nF012_POLYLINE_RESULT_TYPE=" (cdr (assoc 0 (entget f012:polyline-result)))))
(princ (strcat "\nF012_POLYLINE_RESULT_HANDLE=" (cdr (assoc 5 (entget f012:polyline-result)))))
(princ (strcat "\nF012_POLYLINE_RESULT_VERTEX_COUNT=" (itoa (length (vl-remove-if-not '(lambda (item) (= (car item) 10)) (entget f012:polyline-result))))))
(princ (strcat "\nF012_POLYLINE_RESULT_VERTICES=" (f012:point-list (mapcar 'cdr (vl-remove-if-not '(lambda (item) (= (car item) 10)) (entget f012:polyline-result))))))
(princ (strcat "\nF012_POLYLINE_SAMPLE_DEVIATIONS=" (f012:number-list f012:polyline-deviations)))
(princ (strcat "\nF012_POLYLINE_MAX_DEVIATION=" (rtos (apply 'max f012:polyline-deviations) 2 9)))
(setvar "PLINECONVERTMODE" f012:old-plineconvertmode)
(setvar "DELOBJ" f012:old-delobj)
(princ (strcat "\nF012_POLYLINE_SYSTEM_VARS_RESTORED=" (if (and (= (getvar "PLINECONVERTMODE") f012:old-plineconvertmode) (= (getvar "DELOBJ") f012:old-delobj)) "1" "0")))
(princ "\nF012_DONE=1\n")
_.QUIT
_Y
