(defun f016:line (layer y) (entmakex (list '(0 . "LINE") '(100 . "AcDbEntity") (cons 8 layer) '(100 . "AcDbLine") (cons 10 (list 0.0 y 0.0)) (cons 11 (list 1000.0 y 0.0)))))
(defun f016:test-line () (entmakex (list '(0 . "LINE") '(100 . "AcDbEntity") '(8 . "0") '(100 . "AcDbLine") (cons 10 '(10.0 10.0 0.0)) (cons 11 '(180.0 90.0 0.0)))))
(defun f016:rectangle () (entmakex (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") '(8 . "0") '(100 . "AcDbPolyline") '(90 . 4) '(70 . 1) (cons 10 '(0.0 1000.0)) (cons 10 '(1000.0 1000.0)) (cons 10 '(1000.0 1500.0)) (cons 10 '(0.0 1500.0)))))
(defun f016:point (entity code) (cdr (assoc code (entget entity))))
(defun f016:vertex (entity index) (cdr (nth index (vl-remove-if-not '(lambda (pair) (= (car pair) 10)) (entget entity)))))
(defun f016:xy (point) (strcat (rtos (car point) 2 6) "," (rtos (cadr point) 2 6)))
(if (not (tblsearch "LAYER" "F016_LOCKED")) (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord") '(2 . "F016_LOCKED") '(70 . 0) '(62 . 7) '(6 . "CONTINUOUS"))))
(setvar "OSMODE" 0)
(setq f016:e1 (f016:test-line))
(setq f016:e2 (f016:rectangle))
(setq f016:locked (f016:line "F016_LOCKED" 2000.0))
(setq f016:layer-entity (tblobjname "LAYER" "F016_LOCKED"))
(setq f016:layer-data (entget f016:layer-entity))
(entmod (subst (cons 70 (logior 4 (cdr (assoc 70 f016:layer-data)))) (assoc 70 f016:layer-data) f016:layer-data))
(setq f016:ss (ssadd))
(ssadd f016:e1 f016:ss)
(ssadd f016:e2 f016:ss)
(command "_.MOVE" f016:ss "" '(100.0 200.0 0.0) '(600.0 950.0 0.0))
(princ (strcat "\nF016_AFTER1_START=" (f016:xy (f016:point f016:e1 10))))
(princ (strcat "\nF016_AFTER1_END=" (f016:xy (f016:point f016:e1 11))))
(princ (strcat "\nF016_AFTER2_START=" (f016:xy (f016:vertex f016:e2 0))))
(princ (strcat "\nF016_AFTER2_END=" (f016:xy (f016:vertex f016:e2 2))))
(command "_.U")
(princ (strcat "\nF016_UNDO1_START=" (f016:xy (f016:point f016:e1 10))))
(princ (strcat "\nF016_UNDO1_END=" (f016:xy (f016:point f016:e1 11))))
(princ (strcat "\nF016_UNDO2_START=" (f016:xy (f016:vertex f016:e2 0))))
(princ (strcat "\nF016_UNDO2_END=" (f016:xy (f016:vertex f016:e2 2))))
(setq f016:mixed (ssadd))
(ssadd f016:e1 f016:mixed)
(ssadd f016:e2 f016:mixed)
(ssadd f016:locked f016:mixed)
(command "_.MOVE" f016:mixed "" '(0.0 0.0 0.0) '(100.0 50.0 0.0))
(princ (strcat "\nF016_MIX1_START=" (f016:xy (f016:point f016:e1 10))))
(princ (strcat "\nF016_MIX2_START=" (f016:xy (f016:vertex f016:e2 0))))
(princ (strcat "\nF016_LOCKED_START=" (f016:xy (f016:point f016:locked 10))))
(princ (strcat "\nF016_ACADVER=" (getvar "ACADVER")))
(princ "\nF016_DONE=1\n")
_.QUIT
_Y
