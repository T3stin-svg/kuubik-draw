(defun f027:number (value) (rtos value 2 15))
(defun f027:scalar-or-point (value)
  (if (listp value)
    (strcat "[" (f027:number (car value)) "," (f027:number (cadr value)) "," (f027:number (if (caddr value) (caddr value) 0.0)) "]")
    (if (numberp value) (f027:number value) (vl-princ-to-string value))))
(defun f027:print-code (name entity code / data pair)
  (setq data (entget entity))
  (princ (strcat "\nF027_" name "="))
  (foreach pair data (if (= (car pair) code) (progn (princ (f027:scalar-or-point (cdr pair))) (princ ";"))))
  (princ))
(defun f027:print-value (name value) (princ (strcat "\nF027_" name "=")) (princ value) (princ))
(command "_.NETLOAD" (getenv "F027_PLUGIN"))
(command "_.ERASE" "_ALL" "")
(command "_.-LAYER" "_New" "F027_LINE,F027_POLY,F027_CIRCLE,F027_ARC,F027_ELLIPSE,F027_FULL_ELLIPSE,F027_EDGE_CIRCLE,F027_INDIVIDUAL" "")
(setvar "CLAYER" "F027_LINE")
(setq f027:line (entmakex '((0 . "LINE") (100 . "AcDbEntity") (8 . "F027_LINE") (100 . "AcDbLine") (10 0.0 0.0 0.0) (11 100.0 0.0 0.0) (210 0.0 0.0 1.0))))
(setvar "CLAYER" "F027_POLY")
(command "_.PLINE" '(0 100 0) '(100 100 0) '(200 100 0) "")
(setq f027:poly (entlast))
(setvar "CLAYER" "F027_CIRCLE")
(command "_.CIRCLE" '(80 50 0) 5)
(setq f027:circle (entlast))
(command "_.STRETCH" "_Crossing" '(40 -20 0) '(110 120 0) "" '(0 0 0) '(25 5 0))
(f027:print-code "LINE_START" f027:line 10)
(f027:print-code "LINE_END" f027:line 11)
(f027:print-code "POLY_VERTICES" f027:poly 10)
(f027:print-code "CIRCLE_CENTER" f027:circle 10)

(setvar "CLAYER" "F027_ARC")
(setq f027:arc (entmakex '((0 . "ARC") (100 . "AcDbEntity") (8 . "F027_ARC") (100 . "AcDbCircle") (10 300.0 0.0 0.0) (40 . 100.0) (210 0.0 0.0 1.0) (100 . "AcDbArc") (50 . 0.0) (51 . 3.141592653589793))))
(command "F027POINTS")
(command "_.STRETCH" "_Crossing" '(390 -10 0) '(410 10 0) "" '(0 0 0) '(25 5 0))
(f027:print-code "ARC_CENTER" f027:arc 10)
(f027:print-code "ARC_RADIUS" f027:arc 40)
(f027:print-code "ARC_START" f027:arc 50)
(f027:print-code "ARC_END" f027:arc 51)

(setvar "CLAYER" "F027_ELLIPSE")
