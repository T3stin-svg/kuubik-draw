(setvar "CMDECHO" 0)
(command "_.-LAYER" "_Make" "CIRCLE_TEST" "_Color" "3" "CIRCLE_TEST" "")
(command "_.CIRCLE" '(10 10) 5)
(command "_.CIRCLE" '(30 10) "_Diameter" 8)
(command "_.CIRCLE" "_2P" '(50 6) '(50 14))
(command "_.CIRCLE" "_3P" '(75 10) '(70 15) '(65 10))
(command "_.LINE" '(90 -20) '(90 20) "")
(setq f004:ttr-line-1 (entlast))
(command "_.LINE" '(80 0) '(110 0) "")
(setq f004:ttr-line-2 (entlast))
(command "_.CIRCLE" "_TTR" '(90 5) '(95 0) 5)
(setq f004:ttr (entlast))
(command "_.LINE" '(120 -20) '(120 30) "")
(setq f004:ttt-line-1 (entlast))
(command "_.LINE" '(110 0) '(150 0) "")
(setq f004:ttt-line-2 (entlast))
(command "_.LINE" '(140 0) '(120 20) "")
(setq f004:ttt-line-3 (entlast))
(command "_.CIRCLE" "_3P" "_TAN" '(120 6) "_TAN" '(126 0) "_TAN" '(130 10))
(setq f004:ttt (entlast))
(setq f004:all-circles (vl-remove-if-not '(lambda (name) (= (cdr (assoc 0 (entget name))) "CIRCLE")) (vl-remove-if 'listp (mapcar 'cadr (ssnamex (ssget "_X" '((0 . "CIRCLE"))))))))
(setq f004:count-before (length f004:all-circles))
(command "_.UNDO" "1")
(setq f004:count-undo (sslength (ssget "_X" '((0 . "CIRCLE")))))
(command "_.REDO")
(setq f004:count-redo (sslength (ssget "_X" '((0 . "CIRCLE")))))
(setq f004:all-circles (vl-sort (vl-remove-if 'listp (mapcar 'cadr (ssnamex (ssget "_X" '((0 . "CIRCLE")))))) '(lambda (a b) (< (car (cdr (assoc 10 (entget a)))) (car (cdr (assoc 10 (entget b))))))))
(princ (strcat "\nF004_ACADVER=" (getvar "ACADVER")))
(princ (strcat "\nF004_COUNT_BEFORE=" (itoa f004:count-before)))
(princ (strcat "\nF004_COUNT_UNDO=" (itoa f004:count-undo)))
(princ (strcat "\nF004_COUNT_REDO=" (itoa f004:count-redo)))
(princ (strcat "\nF004_CIRCLES=" (apply 'strcat (mapcar '(lambda (name) (setq data (entget name)) (setq center (cdr (assoc 10 data))) (strcat (cdr (assoc 5 data)) "," (cdr (assoc 8 data)) "," (rtos (car center) 2 9) "," (rtos (cadr center) 2 9) "," (rtos (cdr (assoc 40 data)) 2 9) ";")) f004:all-circles))))
(princ "\nF004_DONE=1\n")
_.QUIT
_Y
