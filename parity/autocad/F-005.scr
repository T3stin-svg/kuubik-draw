(setvar "CMDECHO" 0)
(command "_.-LAYER" "_Make" "ARC_TEST" "_Color" "4" "ARC_TEST" "")
(command "_.ARC" '(10 0) '(0 10) '(-10 0))
(command "_.ARC" '(40 0) "_Center" '(30 0) '(30 10))
(command "_.ARC" '(70 0) "_Center" '(60 0) "_Angle" 90)
(command "_.ARC" '(100 0) "_Center" '(90 0) "_Length" 10)
(command "_.ARC" '(120 0) "_End" '(130 0) "_Angle" 180)
(command "_.ARC" '(150 0) "_End" '(160 10) "_Direction" 0)
(command "_.ARC" '(175 0) "_End" '(185 0) "_Radius" 10)
(command "_.ARC" "_Center" '(210 0) '(220 0) '(210 10))
(command "_.ARC" "_Center" '(240 0) '(250 0) "_Angle" 90)
(command "_.ARC" "_Center" '(270 0) '(280 0) "_Length" 10)
(setq f005:all-arcs (vl-remove-if 'listp (mapcar 'cadr (ssnamex (ssget "_X" '((0 . "ARC")))))))
(setq f005:count-before (length f005:all-arcs))
(command "_.UNDO" "1")
(setq f005:count-undo (sslength (ssget "_X" '((0 . "ARC")))))
(command "_.REDO")
(setq f005:count-redo (sslength (ssget "_X" '((0 . "ARC")))))
(setq f005:all-arcs (vl-sort (vl-remove-if 'listp (mapcar 'cadr (ssnamex (ssget "_X" '((0 . "ARC")))))) '(lambda (a b) (< (car (cdr (assoc 10 (entget a)))) (car (cdr (assoc 10 (entget b))))))))
(princ (strcat "\nF005_ACADVER=" (getvar "ACADVER")))
(princ (strcat "\nF005_COUNT_BEFORE=" (itoa f005:count-before)))
(princ (strcat "\nF005_COUNT_UNDO=" (itoa f005:count-undo)))
(princ (strcat "\nF005_COUNT_REDO=" (itoa f005:count-redo)))
(princ (strcat "\nF005_ARCS=" (apply 'strcat (mapcar '(lambda (name) (setq data (entget name)) (setq center (cdr (assoc 10 data))) (strcat (cdr (assoc 5 data)) "," (cdr (assoc 8 data)) "," (rtos (car center) 2 9) "," (rtos (cadr center) 2 9) "," (rtos (cdr (assoc 40 data)) 2 9) "," (rtos (/ (* 180.0 (cdr (assoc 50 data))) pi) 2 9) "," (rtos (/ (* 180.0 (cdr (assoc 51 data))) pi) 2 9) ";")) f005:all-arcs))))
(princ "\nF005_DONE=1\n")
_.QUIT
_Y
