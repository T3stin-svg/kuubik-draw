(defun f015:line (layer y) (entmakex (list '(0 . "LINE") '(100 . "AcDbEntity") (cons 8 layer) '(100 . "AcDbLine") (cons 10 (list 0.0 y 0.0)) (cons 11 (list 1000.0 y 0.0)))))
(defun f015:count-lines () (if (setq f015:all (ssget "_X" '((0 . "LINE")))) (sslength f015:all) 0))
(if (not (tblsearch "LAYER" "F015_LOCKED")) (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord") '(2 . "F015_LOCKED") '(70 . 0) '(62 . 7) '(6 . "CONTINUOUS"))))
(setq f015:e1 (f015:line "0" 0.0))
(setq f015:e2 (f015:line "0" 1000.0))
(setq f015:locked (f015:line "F015_LOCKED" 2000.0))
(setq f015:layer-entity (tblobjname "LAYER" "F015_LOCKED"))
(setq f015:layer-data (entget f015:layer-entity))
(entmod (subst (cons 70 (logior 4 (cdr (assoc 70 f015:layer-data)))) (assoc 70 f015:layer-data) f015:layer-data))
(setq f015:before (f015:count-lines))
(setq f015:ss (ssadd))
(ssadd f015:e1 f015:ss)
(ssadd f015:e2 f015:ss)
(command "_.ERASE" f015:ss "")
(setq f015:after-erase (f015:count-lines))
(command "_.U")
(setq f015:after-undo (f015:count-lines))
(setq f015:locked-ss (ssadd))
(ssadd f015:locked f015:locked-ss)
(command "_.ERASE" f015:locked-ss "")
(setq f015:after-locked (f015:count-lines))
(princ (strcat "\nF015_ACADVER=" (getvar "ACADVER")))
(princ (strcat "\nF015_BEFORE=" (itoa f015:before)))
(princ (strcat "\nF015_AFTER_ERASE=" (itoa f015:after-erase)))
(princ (strcat "\nF015_AFTER_UNDO=" (itoa f015:after-undo)))
(princ (strcat "\nF015_AFTER_LOCKED=" (itoa f015:after-locked)))
(princ (strcat "\nF015_LOCKED_SURVIVED=" (if (entget f015:locked) "1" "0")))
(princ "\nF015_DONE=1\n")
_.QUIT
_Y
