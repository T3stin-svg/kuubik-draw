(defun f026:count (filter / set) (setq set (ssget "_X" filter)) (if set (sslength set) 0))
(defun f026:print-count (name layer / count) (setq count (f026:count (list (cons 8 layer)))) (princ (strcat "\nF026_" name "=")) (princ count) (princ))
(defun f026:print-type-count (name type / count) (setq count (f026:count (list (cons 0 type)))) (princ (strcat "\nF026_" name "=")) (princ count) (princ))
(defun f026:print-types (name layer / set index entity data) (setq set (ssget "_X" (list (cons 8 layer)))) (princ (strcat "\nF026_" name "=")) (if set (progn (setq index 0) (repeat (sslength set) (setq entity (ssname set index)) (setq data (entget entity)) (princ (cdr (assoc 0 data))) (princ ":") (princ (cdr (assoc 5 data))) (princ ";") (setq index (1+ index))))) (princ))
(progn (princ "\nF026_ACADVER=") (princ (getvar "ACADVER")) (princ))
(setq f026:splineSet (ssget "_X" '((0 . "SPLINE"))))
(setq f026:spline (ssname f026:splineSet 0))
(command "_.BREAK" (list f026:spline '(10 20 0)) "_First" '(25 50 0) '(75 -50 0))
(f026:print-type-count "SPLINE_COUNT" "SPLINE")
(command "_.-LAYER" "_New" "F026_DEFAULT,F026_FIRST,F026_AT,F026_CIRCLE_FORWARD,F026_CIRCLE_REVERSE,F026_ARC,F026_ELLIPSE,F026_OPEN_POLY,F026_CLOSED_POLY" "")
(setvar "CLAYER" "F026_DEFAULT")
(command "_.LINE" '(0 0 0) '(100 0 0) "")
(setq f026:default (entlast))
(command "_.BREAK" (list f026:default '(25 0 0)) '(75 20 0))
(setvar "CLAYER" "F026_FIRST")
(command "_.LINE" '(0 100 0) '(100 100 0) "")
(setq f026:first (entlast))
(command "_.BREAK" (list f026:first '(10 100 0)) "_First" '(25 120 0) '(75 80 0))
(setvar "CLAYER" "F026_AT")
(command "_.LINE" '(0 200 0) '(100 200 0) "")
(setq f026:at (entlast))
(command "_.BREAK" (list f026:at '(50 200 0)) "_First" '(50 210 0) "@")
(setvar "CLAYER" "F026_CIRCLE_FORWARD")
(command "_.CIRCLE" '(200 0 0) 50)
(setq f026:circleForward (entlast))
(command "_.BREAK" (list f026:circleForward '(250 0 0)) "_First" '(250 0 0) '(200 50 0))
(setvar "CLAYER" "F026_CIRCLE_REVERSE")
(command "_.CIRCLE" '(350 0 0) 50)
(setq f026:circleReverse (entlast))
(command "_.BREAK" (list f026:circleReverse '(350 50 0)) "_First" '(350 50 0) '(400 0 0))
(setvar "CLAYER" "F026_ARC")
(setq f026:arc (entmakex '((0 . "ARC") (100 . "AcDbEntity") (8 . "F026_ARC") (100 . "AcDbCircle") (10 500.0 0.0 0.0) (40 . 50.0) (210 0.0 0.0 1.0) (100 . "AcDbArc") (50 . 0.0) (51 . 3.141592653589793))))
(command "_.BREAK" (list f026:arc '(535 35 0)) "_First" '(535 35 0) '(465 35 0))
(setvar "CLAYER" "F026_ELLIPSE")
(setq f026:ellipse (entmakex '((0 . "ELLIPSE") (100 . "AcDbEntity") (8 . "F026_ELLIPSE") (100 . "AcDbEllipse") (10 650.0 0.0 0.0) (11 50.0 0.0 0.0) (210 0.0 0.0 1.0) (40 . 0.5) (41 . 0.0) (42 . 6.283185307179586))))
(command "_.BREAK" (list f026:ellipse '(700 0 0)) "_First" '(700 0 0) '(650 25 0))
(setvar "CLAYER" "F026_OPEN_POLY")
(command "_.PLINE" '(0 300 0) '(100 300 0) '(200 300 0) "")
(setq f026:openPoly (entlast))
(command "_.BREAK" (list f026:openPoly '(25 300 0)) "_First" '(25 300 0) '(175 320 0))
(setvar "CLAYER" "F026_CLOSED_POLY")
(command "_.PLINE" '(300 300 0) '(400 300 0) '(400 400 0) '(300 400 0) "_Close")
(setq f026:closedPoly (entlast))
(command "_.BREAK" (list f026:closedPoly '(350 300 0)) "_First" '(350 300 0) '(400 350 0))
(command "_.-LAYER" "_New" "F026_LOCKED,F026_OFF,F026_FROZEN,F026_UNSUPPORTED" "")
(setvar "CLAYER" "F026_LOCKED")
(command "_.LINE" '(0 500 0) '(100 500 0) "")
(setq f026:locked (entlast))
(command "_.-LAYER" "_Lock" "F026_LOCKED" "")
(setq f026:lockedResult (command "_.BREAK" (list f026:locked '(50 500 0)) '(75 500 0) "" ""))
(if (> (getvar "CMDACTIVE") 0) (command))
(command "_.-LAYER" "_Unlock" "F026_LOCKED" "")
(setvar "CLAYER" "F026_OFF")
(command "_.LINE" '(0 550 0) '(100 550 0) "")
(setq f026:off (entlast))
(setvar "CLAYER" "0")
(command "_.-LAYER" "_Off" "F026_OFF" "")
(setq f026:offResult (command "_.BREAK" (list f026:off '(50 550 0)) '(75 550 0) "" ""))
(if (> (getvar "CMDACTIVE") 0) (command))
(command "_.-LAYER" "_On" "F026_OFF" "")
(setvar "CLAYER" "F026_FROZEN")
(command "_.LINE" '(0 600 0) '(100 600 0) "")
(setq f026:frozen (entlast))
(setvar "CLAYER" "0")
(command "_.-LAYER" "_Freeze" "F026_FROZEN" "")
(setq f026:frozenResult (command "_.BREAK" (list f026:frozen '(50 600 0)) '(75 600 0) "" ""))
(if (> (getvar "CMDACTIVE") 0) (command))
(command "_.-LAYER" "_Thaw" "F026_FROZEN" "")
(setvar "CLAYER" "F026_UNSUPPORTED")
(setq f026:unsupported (entmakex '((0 . "TEXT") (100 . "AcDbEntity") (8 . "F026_UNSUPPORTED") (100 . "AcDbText") (10 0.0 650.0 0.0) (40 . 10.0) (1 . "unsupported") (50 . 0.0) (41 . 1.0) (51 . 0.0) (7 . "Standard") (71 . 0) (72 . 0) (11 0.0 650.0 0.0) (210 0.0 0.0 1.0) (100 . "AcDbText") (73 . 0))))
(setq f026:unsupportedResult (command "_.BREAK" (list f026:unsupported '(10 650 0)) '(20 650 0) "" ""))
(if (> (getvar "CMDACTIVE") 0) (command))
(f026:print-count "DEFAULT_COUNT" "F026_DEFAULT")
(f026:print-count "FIRST_COUNT" "F026_FIRST")
(f026:print-count "AT_COUNT" "F026_AT")
(f026:print-types "CIRCLE_FORWARD_TYPES" "F026_CIRCLE_FORWARD")
(f026:print-types "CIRCLE_REVERSE_TYPES" "F026_CIRCLE_REVERSE")
(f026:print-count "ARC_COUNT" "F026_ARC")
(f026:print-count "ELLIPSE_COUNT" "F026_ELLIPSE")
(f026:print-count "OPEN_POLY_COUNT" "F026_OPEN_POLY")
(f026:print-count "CLOSED_POLY_COUNT" "F026_CLOSED_POLY")
(f026:print-count "LOCKED_COUNT" "F026_LOCKED")
(f026:print-count "OFF_COUNT" "F026_OFF")
(f026:print-count "FROZEN_COUNT" "F026_FROZEN")
(f026:print-count "UNSUPPORTED_COUNT" "F026_UNSUPPORTED")
(princ "\nF026_DONE=1")
(princ)
