(f027:print-code "ELLIPSE_QUARTER_END" f027:ellipseQuarter 42)

(setq f027:ellipseArbitrary (entmakex '((0 . "ELLIPSE") (100 . "AcDbEntity") (8 . "F027_ELLIPSE") (100 . "AcDbEllipse") (10 1400.0 0.0 0.0) (11 100.0 0.0 0.0) (210 0.0 0.0 1.0) (40 . 0.5) (41 . 0.3) (42 . 2.2))))
