(command "F027POINTS")
(command "_.STRETCH" "_Crossing" '(690 -10 0) '(710 10 0) "" '(0 0 0) '(25 5 0))
(f027:print-code "ELLIPSE_CENTER" f027:ellipse 10)
(f027:print-code "ELLIPSE_MAJOR" f027:ellipse 11)
(f027:print-code "ELLIPSE_RATIO" f027:ellipse 40)
(f027:print-code "ELLIPSE_START" f027:ellipse 41)
(f027:print-code "ELLIPSE_END" f027:ellipse 42)

(setq f027:ellipseQuarter (entmakex '((0 . "ELLIPSE") (100 . "AcDbEntity") (8 . "F027_ELLIPSE") (100 . "AcDbEllipse") (10 1000.0 0.0 0.0) (11 100.0 0.0 0.0) (210 0.0 0.0 1.0) (40 . 0.5) (41 . 0.0) (42 . 1.570796326794897))))
(command "F027POINTS")
(command "_.REGEN")
(command "_.STRETCH" "_Crossing" '(1080 -20 0) '(1120 30 0) "" '(0 0 0) '(25 5 0))
(f027:print-code "ELLIPSE_QUARTER_CENTER" f027:ellipseQuarter 10)
(f027:print-code "ELLIPSE_QUARTER_MAJOR" f027:ellipseQuarter 11)
(f027:print-code "ELLIPSE_QUARTER_RATIO" f027:ellipseQuarter 40)
